{
  "schemaVersion": "1.1",
  "purpose": "Fail-closed schema integrity for manually reviewed Visual Fidelity evidence. This contract does not award visual points; it prevents ambiguous, duplicated or incomplete review records from reaching the numeric gate and requires current runtime diagnostics for render-only repetition and temporal risks.",
  "requiredViews": [
    "hero",
    "oblique",
    "grazing"
  ],
  "categories": [
    { "id": "geometry_construction", "weight": 20, "hardMinimum": 18 },
    { "id": "material_pbr", "weight": 20, "hardMinimum": 18 },
    { "id": "lighting_shadows_reflections", "weight": 15, "hardMinimum": 13 },
    { "id": "texture_microdetail", "weight": 10, "hardMinimum": 9 },
    { "id": "weathering_causality", "weight": 10, "hardMinimum": 9 },
    { "id": "vegetation_natural_complexity", "weight": 8, "hardMinimum": 7 },
    { "id": "period_authenticity", "weight": 7, "hardMinimum": 6 },
    { "id": "cinematic_image", "weight": 5, "hardMinimum": 4 },
    { "id": "temporal_lod_aliasing", "weight": 5, "hardMinimum": 4 }
  ],
  "criticalDefectIds": [
    "visible_primitive_placeholder",
    "baked_or_painted_highlights",
    "impossible_material_physics",
    "obvious_repetition",
    "hero_geometry_intersection",
    "sun_shadow_inconsistency",
    "forbidden_disaster_theme",
    "severe_aliasing_or_shimmer",
    "visible_lod_pop",
    "major_light_leak",
    "missing_construction_material_metadata",
    "unverified_render_claim"
  ],
  "rules": {
    "rejectDuplicateViewEntries": true,
    "rejectDuplicateCategoryEntries": true,
    "rejectDuplicateCriticalDefectEntries": true,
    "rejectUnknownEntries": true,
    "requireExactlyNineCategoryEntries": true,
    "requireExactlyTwelveCriticalDefectEntries": true,
    "requireCategoryEvidenceText": true,
    "requireCategoryCorrectiveActionText": true,
    "requireDeductionTextWhenScoreBelowWeight": true,
    "requireCriticalDefectEvidenceText": true,
    "requireAtLeastOneObservedReferencePerCategory": true,
    "requireAtLeastOneObservedReferencePerCriticalDefect": true,
    "requireRenderVerifiedTrueForReviewedEvidence": true,
    "requireCurrentRenderedRepetitionDiagnostics": true,
    "renderedRepetitionDiagnosticsCannotClearCriticalDefect": true
  },
  "runtimeDiagnosticPreconditions": {
    "renderedRepetition": {
      "owner": "QualityBlockRenderedRepetitionDiagnostics.ValidateLatestReportForScoring",
      "reportPath": "Assets/QA/rendered_repetition_diagnostics.json",
      "requireCurrentManifestSha256": true,
      "requireCurrentCropSha256": true,
      "warningOnly": true,
      "mayAutomaticallyClearObviousRepetition": false,
      "reason": "Static hierarchy/UV checks cannot establish whether repetition is immediately obvious in the actual post-tonemap native-4K pixels. The current rendered triage report is therefore mandatory, but the final critical-defect decision remains a direct human pixel review."
    },
    "temporalRuntime": {
      "owner": "QualityBlockTemporalRuntimeEvidenceGuard.ValidateLatestReceiptForScoring",
      "requireSealedPerFrameLightingFingerprint": true,
      "requireFilmicHdrToLdrForEveryFrame": true,
      "requireZeroFallback": true
    }
  },
  "visualScoreAwardedByThisQA": false,
  "runtimeRenderVerified": false,
  "note": "Implementation Readiness and source-side validation remain separate from Visual Fidelity. Reviewed evidence must still pass render provenance, observability, current SHA-256-bound rendered repetition triage, temporal sealing and the canonical 92/100 gate. Repetition diagnostics never substitute for direct review and never clear obvious_repetition by themselves."
}
